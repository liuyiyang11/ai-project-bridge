# Copy this file to config.local.yaml. Keep the copy private and ignored.
control_repo: "YOUR_GITHUB_NAME/ai-project-bridge"
trusted_github_logins:
  - "YOUR-GITHUB-NAME"
poll_seconds: 30
python_executable: 'E:\anaconda\envs\py39\python.exe'

limits:
  max_artifact_file_mb: 25
  max_bundle_mb: 100
  max_images: 20

projects:
  unetmamba:
    capabilities: [code, experiment-review]
    root: "D:/Projects/UNetMamba"
    repo: "YOUR_GITHUB_NAME/UNetMamba"
    remote: origin
    base_branch: main
    allowed_commands:
      quick_test:
        argv: ["python", "-m", "pytest", "-q"]
      evaluate:
        argv: ["python", "tools/evaluate.py"]
    artifact_dirs: ["outputs", "results", "runs"]

  thesis-ppt:
    capabilities: [presentation]
    root: "D:/Presentations/ThesisDefense"
    repo: "YOUR_GITHUB_NAME/ThesisDefense"
    remote: origin
    base_branch: main
    allowed_commands: {}
    artifact_dirs: []

